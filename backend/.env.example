# --- Core ---
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# --- Database ---
# SQLite is the default. To use a different DB, point at a SQLAlchemy URL.
DATABASE_URL=sqlite:///./data/poiro.db

# --- CORS ---
# Comma-separated list of allowed origins for the frontend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI Provider ---
# Provider can be "gemini" or "mock". If "gemini" is selected but no key is
# supplied, the backend will transparently fall back to the mock provider so
# the battle room is always playable end-to-end.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# On 429 / daily quota, complete jobs with mock output instead of failing (default: true).
GEMINI_FALLBACK_TO_MOCK=true
# Max Gemini model IDs tried per job when the primary returns 404 (default: 2).
GEMINI_MAX_MODEL_ATTEMPTS=2

# --- Python deps note ---
# Email fields require: pip install email-validator  (included in requirements.txt)

# --- Job Worker ---
# Concurrency cap for the in-process async worker pool.
WORKER_CONCURRENCY=3
# Per-job hard timeout in seconds before it is marked timed_out.
JOB_TIMEOUT_SECONDS=45
# Number of retry attempts on transient provider failures.
JOB_MAX_ATTEMPTS=1
